@namespace MCB2B.Components

<div class="mc-card p-6 flex flex-col justify-between relative group hover:-translate-y-1 transition-all duration-300 @Rank.BorderClass @(Rank.IsPopular ? "ring-2 ring-cyan-500/50 shadow-[0_0_30px_rgba(6,182,212,0.15)]" : "")">
    @if (Rank.IsPopular)
    {
        <div class="absolute -top-3.5 right-6 bg-gradient-to-r from-cyan-500 to-blue-500 text-gray-950 text-[11px] font-black uppercase tracking-wider px-3 py-0.5 rounded-full shadow-lg shadow-cyan-950/40">
            Supreme Tier
        </div>
    }
    else if (Rank.IsFeatured)
    {
        <div class="absolute -top-3.5 right-6 bg-purple-600 text-white text-[11px] font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-lg shadow-purple-950/40">
            Popular Choice
        </div>
    }

    <div>
        <!-- Tier Header -->
        <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold border @Rank.BadgeBgClass @Rank.BadgeTextClass">
                @Rank.PrefixTag
            </span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tier @Rank.Tier</span>
        </div>

        <h3 class="text-2xl font-black text-white tracking-wide mb-1 font-mono group-hover:text-amber-400 transition-colors">
            @Rank.Name
        </h3>

        <p class="text-gray-400 text-xs leading-relaxed mb-5 min-h-[36px]">
            @Rank.ShortDescription
        </p>

        <!-- Price Display -->
        <div class="mb-6 pb-4 border-b border-gray-800">
            <div class="flex items-baseline space-x-1">
                <span class="text-3xl font-extrabold text-white font-mono">$@Rank.Price.ToString("0.00")</span>
                <span class="text-xs text-gray-400 font-medium">USD / one-time</span>
            </div>
            <div class="text-[11px] text-gray-400 mt-0.5">Lifetime server status</div>
        </div>

        <!-- Perks List -->
        <div class="mb-6 space-y-2.5">
            <div class="text-[11px] font-bold uppercase tracking-wider text-gray-400">Included Perks:</div>
            <ul class="space-y-2 text-xs text-gray-300">
                @foreach (var perk in Rank.Perks.Take(4))
                {
                    <li class="flex items-start space-x-2">
                        <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="leading-tight">@perk</span>
                    </li>
                }
                @if (Rank.Perks.Count > 4)
                {
                    <li class="text-[11px] text-gray-400 italic pl-6">
                        + @(Rank.Perks.Count - 4) more exclusive privileges...
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (ShowActions)
    {
        <!-- Action Buttons -->
        <div class="pt-4 border-t border-gray-800/80 flex flex-col space-y-2">
            <button @onclick="() => OnBuyNow.InvokeAsync(Rank)" 
                    class="w-full py-2.5 px-4 rounded-lg font-bold text-sm tracking-wide transition-all duration-200 active:scale-[0.98] @Rank.ButtonClass shadow-md">
                Buy Now
            </button>
            <button @onclick="() => OnViewDetails.InvokeAsync(Rank)" 
                    class="w-full py-2 px-4 rounded-lg font-medium text-xs text-gray-400 hover:text-white bg-gray-900/60 hover:bg-gray-800 border border-gray-800 hover:border-gray-700 transition-colors">
                View Details
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public RankProduct Rank { get; set; } = default!;

    [Parameter]
    public EventCallback<RankProduct> OnViewDetails { get; set; }

    [Parameter]
    public EventCallback<RankProduct> OnBuyNow { get; set; }

    [Parameter]
    public bool ShowActions { get; set; } = true;
}
