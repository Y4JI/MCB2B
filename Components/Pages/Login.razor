@page "/login"
@inject SessionState SessionState
@inject AccountStore AccountStore
@inject NavigationManager Navigation

<PageTitle>Aetheria Network | Player Login</PageTitle>

<div class="py-16 max-w-md mx-auto px-4 sm:px-6">
    <div class="mc-card p-8 border-gray-700 bg-gray-900 shadow-2xl">
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
            </div>
            <h1 class="text-2xl font-black text-white font-mono">Sign In to Aetheria</h1>
            <p class="text-xs text-gray-400 mt-1">Access your player dashboard and unlocked server perks</p>
        </div>

        <!-- Redirect Notice (if redirected from Buy Now) -->
        @if (ShowLoginRequiredNotice)
        {
            <div class="mb-5 p-3 rounded-lg bg-amber-950/40 border border-amber-600/40 text-xs text-amber-200 flex items-start space-x-2.5">
                <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>You must be signed in to purchase a server rank. Please sign in or register below.</span>
            </div>
        }

        <!-- Pre-seeded Demo Credentials Hint -->
        <div class="mb-6 p-3.5 rounded-lg bg-gray-950 border border-gray-800 text-xs text-gray-300">
            <div class="flex items-center justify-between font-mono font-bold text-amber-400 text-[11px] uppercase tracking-wider mb-1.5">
                <span>Demo Account Available</span>
                <span class="text-gray-500 font-normal">Instant Access</span>
            </div>
            <div class="space-y-1 font-mono text-[11px] text-gray-400">
                <div>Username: <span class="text-white font-semibold">demo</span> (or <span class="text-white">demo@aetheria.net</span>)</div>
                <div>Password: <span class="text-white font-semibold">demo123</span></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-5 p-3 rounded-lg bg-red-950/50 border border-red-500/50 text-xs text-red-200 flex items-start space-x-2">
                <svg class="w-4 h-4 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>@_errorMessage</span>
            </div>
        }

        <!-- Login Form -->
        <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div>
                    <label for="usernameOrEmail" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5 font-mono">
                        Username or Email
                    </label>
                    <InputText id="usernameOrEmail" 
                               @bind-Value="_loginModel.UsernameOrEmail"
                               class="w-full px-3.5 py-2.5 rounded-lg bg-gray-950 border border-gray-700 text-white placeholder-gray-500 text-sm focus:border-amber-400 transition-colors"
                               placeholder="e.g. demo or demo@aetheria.net" />
                    <ValidationMessage For="@(() => _loginModel.UsernameOrEmail)" class="text-xs text-red-400 mt-1 block" />
                </div>

                <div>
                    <label for="password" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5 font-mono">
                        Password
                    </label>
                    <InputText id="password" 
                               type="password"
                               @bind-Value="_loginModel.Password"
                               class="w-full px-3.5 py-2.5 rounded-lg bg-gray-950 border border-gray-700 text-white placeholder-gray-500 text-sm focus:border-amber-400 transition-colors"
                               placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-xs text-red-400 mt-1 block" />
                </div>

                <div class="pt-2">
                    <button type="submit" 
                            class="w-full mc-button-primary py-2.5 text-sm font-bold tracking-wide">
                        Sign In
                    </button>
                </div>
            </div>
        </EditForm>

        <!-- Register Link -->
        <div class="mt-6 pt-6 border-t border-gray-800 text-center text-xs text-gray-400">
            Don't have an account yet?
            <NavLink href="register" class="text-amber-400 hover:text-amber-300 font-semibold ml-1">
                Register here &rarr;
            </NavLink>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    public string? MessageQuery { get; set; }

    private bool ShowLoginRequiredNotice => string.Equals(MessageQuery, "login_required", StringComparison.OrdinalIgnoreCase);

    private LoginModel _loginModel = new();
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        // If already logged in, navigate straight to dashboard
        if (SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    private void HandleLogin()
    {
        _errorMessage = null;

        var account = AccountStore.Authenticate(_loginModel.UsernameOrEmail, _loginModel.Password);
        if (account == null)
        {
            _errorMessage = "Invalid credentials. Please verify your username/email and password.";
            return;
        }

        // Establish session and route to dashboard
        SessionState.Login(account);
        Navigation.NavigateTo("/dashboard");
    }
}
