@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="py-16 max-w-xl mx-auto px-4">
    <div class="mc-card p-8 border-red-500/40 bg-gray-900 text-center">
        <h1 class="text-3xl font-black text-red-400 font-mono mb-2">Unexpected Error</h1>
        <p class="text-sm text-gray-300 mb-6">An error occurred while processing your request.</p>

        @if (ShowRequestId)
        {
            <div class="p-3 bg-gray-950 rounded border border-gray-800 text-xs font-mono text-gray-400 mb-4">
                <strong>Request ID:</strong> <code class="text-amber-400">@RequestId</code>
            </div>
        }

        <a href="/" class="mc-button-primary text-sm py-2 px-6">Return to Home</a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
