@inject SessionState SessionState
@inject NavigationManager Navigation
@implements IDisposable

<header class="sticky top-0 z-40 w-full border-b border-minecraft-border bg-minecraft-dark/95 backdrop-blur shadow-lg shadow-black/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Brand Logo & Identity -->
            <div class="flex items-center space-x-4">
                <NavLink href="" class="flex items-center space-x-3 group text-decoration-none">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-md shadow-amber-950/50 border border-amber-400/40 group-hover:scale-105 transition-transform">
                        <svg class="w-6 h-6 text-gray-950" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                        </svg>
                    </div>
                    <div>
                        <div class="font-extrabold text-lg tracking-wider text-white group-hover:text-amber-400 transition-colors uppercase font-mono">
                            Aetheria<span class="text-amber-500">Net</span>
                        </div>
                        <div class="text-[10px] uppercase tracking-widest text-gray-400 font-semibold">
                            Rank & Perks Store
                        </div>
                    </div>
                </NavLink>

                <!-- Server Live Ping Simulation Badge -->
                <div class="hidden md:flex items-center space-x-2 px-3 py-1 bg-gray-900/90 border border-gray-800 rounded-full text-xs">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span class="text-gray-400 font-mono">play.aetheria.net</span>
                    <span class="text-gray-600">|</span>
                    <span class="text-emerald-400 font-semibold font-mono">1,428 Online</span>
                </div>
            </div>

            <!-- Desktop Navigation Links -->
            <nav class="flex items-center space-x-1 sm:space-x-2">
                <NavLink href="" Match="NavLinkMatch.All" 
                         class="px-3 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/60 transition-colors"
                         ActiveClass="bg-gray-800 text-amber-400 border border-amber-500/30">
                    Home
                </NavLink>

                <NavLink href="store" 
                         class="px-3 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/60 transition-colors"
                         ActiveClass="bg-gray-800 text-amber-400 border border-amber-500/30">
                    Store
                </NavLink>

                @if (SessionState.IsLoggedIn)
                {
                    <NavLink href="dashboard" 
                             class="px-3 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/60 transition-colors"
                             ActiveClass="bg-gray-800 text-amber-400 border border-amber-500/30">
                        Dashboard
                    </NavLink>

                    <NavLink href="profile" 
                             class="px-3 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/60 transition-colors"
                             ActiveClass="bg-gray-800 text-amber-400 border border-amber-500/30">
                        Profile
                    </NavLink>
                }
            </nav>

            <!-- User Auth Controls -->
            <div class="flex items-center space-x-3">
                @if (SessionState.IsLoggedIn)
                {
                    <div class="flex items-center space-x-3">
                        <div class="flex items-center space-x-2 px-3 py-1.5 bg-gray-900 border border-gray-800 rounded-lg">
                            <div class="w-6 h-6 rounded bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-xs font-bold text-gray-950 font-mono">
                                @(SessionState.CurrentUser?.Username.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="text-sm font-medium text-gray-200">@SessionState.CurrentUser?.Username</span>
                        </div>

                        <button @onclick="HandleLogout"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg text-gray-400 hover:text-red-300 hover:bg-red-950/40 border border-transparent hover:border-red-900/50 transition-colors">
                            Logout
                        </button>
                    </div>
                }
                else
                {
                    <div class="flex items-center space-x-2">
                        <NavLink href="login" 
                                 class="px-3 py-1.5 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800 transition-colors">
                            Login
                        </NavLink>
                        <NavLink href="register" 
                                 class="mc-button-primary text-sm py-1.5 px-3">
                            Register
                        </NavLink>
                    </div>
                }
            </div>
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
    }

    private void HandleLogout()
    {
        SessionState.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
